# ============================================================
# Enterprise PDF Q&A Platform – Environment Variables
# ============================================================

# ── App ──────────────────────────────────────────────────────
APP_NAME="Enterprise PDF Q&A"
APP_ENV=development        # development | staging | production
SECRET_KEY=change-me-super-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Database ─────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pdf_qa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/pdf_qa

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── AI / LLM ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-...

# Primary LLM (openai | anthropic)
PRIMARY_LLM=openai
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Embeddings ───────────────────────────────────────────────
EMBEDDING_PROVIDER=openai           # openai | huggingface
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
HF_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1536            # 1536 keeps HNSW within pgvector's 2000-dim limit

# ── Reranker ─────────────────────────────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2
RERANKER_TOP_K=5

# ── Unstructured ─────────────────────────────────────────────
# UNSTRUCTURED_API_KEY=             # Leave empty to use local pypdf parsing
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_API_URL=https://api.unstructured.io/general/v0/general

# ── RAG ──────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=20
FINAL_TOP_K=5
HYBRID_ALPHA=0.7                    # weight for dense vs sparse (0=sparse,1=dense)

# ── Storage ──────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50

# ── Observability ────────────────────────────────────────────
LOG_LEVEL=INFO
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...           # LangSmith
LANGCHAIN_PROJECT=enterprise-pdf-qa
